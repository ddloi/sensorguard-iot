{
  "title": "SensorGuard — Giám sát vận hành",
  "description": "Dữ liệu SensorGuard gửi qua Datadog HTTP API. Chỉ có dữ liệu mới khi app đang chạy (npm run dev).",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "development"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "tick_pos": "50%",
        "tick_edge": "left",
        "has_padding": true,
        "content": "**SensorGuard** — 5 thiết bị mô phỏng gửi số đo mỗi 5 giây. Chọn khung thời gian **Past 15 Minutes** khi app đang chạy, hoặc **Past 1 Day** để xem lần chạy trước.\n\nMetric được gửi qua HTTP API (không cần Datadog Agent)."
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Tổng quan",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "query_value",
              "title": "Thiết bị online",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "q": "max:sensorguard.device.count{status:online,env:$env}",
                  "aggregator": "last"
                }
              ],
              "autoscale": true,
              "precision": 0
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Mẫu dữ liệu đã nhận",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "q": "sum:sensorguard.sensor.ingest.count{env:$env}.as_count()",
                  "aggregator": "sum"
                }
              ],
              "autoscale": true,
              "precision": 0
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Cảnh báo đã tạo",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "q": "sum:sensorguard.sensor.alert.triggered{env:$env}.as_count()",
                  "aggregator": "sum"
                }
              ],
              "autoscale": true,
              "precision": 0
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Thời gian xử lý sự cố gần nhất",
              "title_size": "16",
              "title_align": "left",
              "requests": [
                {
                  "q": "max:sensorguard.incident.duration{env:$env}",
                  "aggregator": "last"
                }
              ],
              "autoscale": true,
              "precision": 0,
              "custom_unit": "giây"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Dữ liệu cảm biến",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Nhiệt độ theo thiết bị (°C)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:sensorguard.sensor.reading.value{sensor_type:temperature,env:$env} by {device}",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "MOTOR-001 — nhiệt độ và ngưỡng demo",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:sensorguard.sensor.reading.value{device:motor-001,sensor_type:temperature,env:$env}",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "metadata": [
                    {
                      "expression": "avg:sensorguard.sensor.reading.value{device:motor-001,sensor_type:temperature,env:$env}",
                      "alias_name": "Nhiệt độ MOTOR-001"
                    }
                  ]
                }
              ],
              "markers": [
                {
                  "value": "y = 85",
                  "display_type": "error dashed",
                  "label": "Critical 85°C"
                },
                {
                  "value": "y = 80",
                  "display_type": "warning dashed",
                  "label": "Warning 80°C"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Độ rung theo thiết bị (mm/s)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:sensorguard.sensor.reading.value{sensor_type:vibration,env:$env} by {device}",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Tốc độ nhận dữ liệu (mẫu)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:sensorguard.sensor.ingest.count{env:$env}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Phát hiện → điều tra → xử lý",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Vượt ngưỡng theo mức độ",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:sensorguard.sensor.threshold.exceeded{env:$env} by {severity}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Cảnh báo và khắc phục",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "sum:sensorguard.sensor.alert.triggered{env:$env}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "metadata": [
                    {
                      "expression": "sum:sensorguard.sensor.alert.triggered{env:$env}.as_count()",
                      "alias_name": "Cảnh báo"
                    }
                  ]
                },
                {
                  "q": "sum:sensorguard.remediation.executed{env:$env}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "metadata": [
                    {
                      "expression": "sum:sensorguard.remediation.executed{env:$env}.as_count()",
                      "alias_name": "Khắc phục"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian xử lý sự cố (giây)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:sensorguard.incident.duration{env:$env}",
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thiết bị theo trạng thái",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "max:sensorguard.device.count{env:$env} by {status}",
                  "display_type": "area",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Thời gian xử lý job theo hàng đợi (ms)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "q": "avg:sensorguard.queue.job.duration{env:$env} by {queue}",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Nhật ký",
        "layout_type": "ordered",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "log_stream",
              "title": "Log cảnh báo và sự cố",
              "title_size": "16",
              "title_align": "left",
              "query": "service:sensorguard",
              "indexes": [],
              "columns": ["host", "service"],
              "message_display": "expanded-md",
              "show_date_column": true,
              "show_message_column": true,
              "sort": {
                "column": "time",
                "order": "desc"
              }
            }
          }
        ]
      }
    }
  ]
}

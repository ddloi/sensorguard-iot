# ============================================
# SensorGuard — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sensorguard?retryWrites=true&w=majority
MONGODB_DB_NAME=sensorguard

# --- Redis (BullMQ queues) ---
# Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379 (TLS, free plan has a command quota)
# Local rehearsals without a quota: run `npm run redis:local`, then use redis://localhost:6379
UPSTASH_REDIS_URL=rediss://<your-upstash-endpoint>:6379
UPSTASH_REDIS_TOKEN=<your-upstash-token>
# TLS follows the URL scheme (rediss:// = TLS). Override with true/false only if needed.
REDIS_TLS=auto

# --- Device credential for POST /api/ingest ---
# When set, devices and the simulator must send header x-device-key with this value.
# Leave empty for a local demo. The dashboard demo button uses /api/demo/overheat instead.
DEVICE_API_KEY=

# --- Datadog ---
DD_API_KEY=<your-datadog-api-key>
DD_SITE=datadoghq.com
DD_SERVICE=sensorguard
DD_ENV=development

# --- API Server ---
API_PORT=3001
API_HOST=0.0.0.0

# --- Simulator and read-only pre-demo verification ---
API_URL=http://127.0.0.1:3001
DASHBOARD_URL=http://127.0.0.1:3000

# Vite serves the dashboard on port 3000 and proxies /api, /health and /ws.
# Cloud credentials belong only in this server-side .env file, never in VITE_*.

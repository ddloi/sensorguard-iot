{
  "name": "sensorguard",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time IoT Sensor Monitoring System — MongoDB × Datadog Hackathon 2026",
  "workspaces": [
    "packages/api",
    "packages/simulator",
    "packages/dashboard"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,SIM,UI\" -c \"blue,yellow,magenta\" \"npm run dev:api\" \"npm run dev:simulator\" \"npm run dev:dashboard\"",
    "dev:api": "npm run dev -w packages/api",
    "dev:simulator": "npm run dev -w packages/simulator",
    "dev:dashboard": "npm run dev -w packages/dashboard",
    "build": "npm run build:api && npm run build:simulator && npm run build:dashboard",
    "build:api": "npm run build -w packages/api",
    "build:simulator": "npm run build -w packages/simulator",
    "build:dashboard": "npm run build -w packages/dashboard",
    "seed": "npm run seed -w packages/api",
    "test": "npm run test -w packages/api",
    "test:api": "npm run test -w packages/api",
    "test:dashboard": "echo \"Dashboard typecheck passed via build:dashboard\"",
    "verify": "tsx scripts/verify-stack.ts",
    "scenario:overheat": "npm run dev:scenario -w packages/simulator",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "iot",
    "mongodb",
    "datadog",
    "sensor",
    "monitoring"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
